{
  "name": "enterprise-component-sources",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @enterprise/portal dev",
    "dev:all": "pnpm --parallel --filter './frontend/apps/*' --filter './frontend/modules/*' dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@types/node": "^22.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
